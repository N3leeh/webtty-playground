FROM debian:trixie
LABEL purpose=jail

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    procps \
    iproute2 \
    iputils-ping \
    nano \
    vim \
    sudo \
    less \
    python3 \
    lsof \
    man \
    cowsay \
    fortune \
    sl \
    locales-all \
    && rm -rf /var/lib/apt/lists/*

# "Set disable_coredump false" unterdrückt die Warnung
# "sudo: setrlimit(RLIMIT_CORE): Operation not permitted", die erscheint,
# wenn der Container ohne CAP_SYS_RESOURCE läuft (siehe jail_capabilities).
RUN printf '%s\n' \
        '%users ALL=(ALL) NOPASSWD:ALL' \
        'Set disable_coredump false' \
        > /etc/sudoers.d/workshop \
    && chmod 0440 /etc/sudoers.d/workshop

ENV LANG=de_DE.UTF-8

# Make it a bit fancy
RUN echo 'export PS1="🐳 \u:\W# "' >> /etc/profile
RUN echo 'export LS_OPTIONS="--color=auto"' >> /etc/profile
RUN echo 'eval "$(dircolors)"' >> /etc/profile
RUN echo 'alias ls="ls $LS_OPTIONS"' >> /etc/profile
