FROM debian:trixie
LABEL purpose=jail

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    procps \
    iproute2 \
    iputils-ping \
    nano \
    vim \
    sudo \
    less \
    python3 \
    lsof \
    file \
    curl \
    man \
    cowsay \
    fortune \
    sl \
    locales-all \
    && rm -rf /var/lib/apt/lists/*

# sudo ohne Passwort für die Teilnehmenden (Gruppe users).
# Die Datei wird beim Bauen mit visudo geprüft - ein Syntaxfehler bricht den
# Build ab, statt erst beim "sudo" der Teilnehmenden aufzufallen.
RUN printf '%s\n' '%users ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/workshop \
    && chmod 0440 /etc/sudoers.d/workshop \
    && visudo -cf /etc/sudoers.d/workshop

# Unterdrückt die Warnung "sudo: setrlimit(RLIMIT_CORE): Operation not
# permitted" (Container ohne CAP_SYS_RESOURCE, siehe jail_capabilities).
# Gehört in /etc/sudo.conf, NICHT in eine sudoers-Datei.
RUN echo 'Set disable_coredump false' >> /etc/sudo.conf

ENV LANG=de_DE.UTF-8

# Make it a bit fancy
RUN echo 'export PS1="🐳 \u:\W# "' >> /etc/profile
RUN echo 'export LS_OPTIONS="--color=auto"' >> /etc/profile
RUN echo 'eval "$(dircolors)"' >> /etc/profile
RUN echo 'alias ls="ls $LS_OPTIONS"' >> /etc/profile
