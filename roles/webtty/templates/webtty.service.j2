[Unit]
Description=WebTTY Service
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
TimeoutStartSec=0
Restart=always
RestartSec=5
# Reste eines alten Containers entfernen ("-": Fehler, wenn es keinen gibt, ist egal)
ExecStartPre=-/usr/bin/docker rm -f %n
# Kein "docker pull" beim Start: das Image zieht Ansible beim Ausrollen.
# So hängt ein (Neu-)Start nicht an Docker Hub (Pull-Limits bei Hetzner & Co.).
ExecStart=/usr/bin/docker run --rm --name %n \
  -p {{ webtty_bind_ip }}:3000:3000 \
  {{ webtty_image }} \
  --host=0.0.0.0 \
  --port=3000 \
  --base=/ \
{% for origin in webtty_origins %}
  --allowed-origin={{ origin }} \
{% endfor %}
  --ssh-host={{ webtty_bind_ip }}
ExecStop=/usr/bin/docker stop %n

[Install]
WantedBy=multi-user.target
